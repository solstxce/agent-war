APP_ENVIRONMENT=development
DATA_MODE=auto
# Explicit mock distance/ETA, with no Maps calls. Use google_maps for real route evidence.
ROUTING_MODE=synthetic_demo
# Development only, and only for workspaces marked by logistics-demo seed.
ALLOW_CLOUD_DEMO_RESET=false
GOOGLE_CLOUD_PROJECT=
# Recovery APIs require dispatcher membership in this existing Firestore workspace.
RECOVERY_WORKSPACE_ID=agentwars-demo
LOCATION_MAX_AGE_SECONDS=900
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Optional existing project variable. Configure both emulator hosts together if used.
FIREBASE_PROJECT_ID=
FIRESTORE_EMULATOR_HOST=
# Cloud mode: clear both FIRESTORE_EMULATOR_HOST and FIREBASE_AUTH_EMULATOR_HOST.
# Optional explicit service-account path; leave empty to use ambient ADC.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_API_KEY=
# Published in Google's official Gemini cookbook; check access with logistics-models.
GEMINI_MODEL=gemini-3.8-flash
LOGISTICS_MCP_URL=http://127.0.0.1:8001/mcp
# Separate server key restricted to Geocoding API and Routes API.
GOOGLE_MAPS_SERVER_API_KEY=
GOOGLE_MAPS_API_KEY=
MAPS_REQUEST_TIMEOUT_SECONDS=10

# Bounded local agent runtime
AGENT_TOOL_MAX_RETRIES=2
AGENT_MAX_LLM_CALLS=12
# ADK CLI/web runner limit
ADK_MAX_LLM_CALLS=12

# Optional telemetry; disabled until explicitly configured
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# Development only: host:port, without http://
FIREBASE_AUTH_EMULATOR_HOST=
