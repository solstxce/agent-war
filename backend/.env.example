APP_ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Use demo-agent-war with the local Firebase emulators.
FIREBASE_PROJECT_ID=demo-agent-war
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# Cloud Firestore: clear FIRESTORE_EMULATOR_HOST and configure ADC externally.
# GOOGLE_APPLICATION_CREDENTIALS=C:/path/outside/repository/service-account.json
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LOGISTICS_MCP_URL=http://127.0.0.1:8001/mcp
# Separate server key restricted to Geocoding API and Routes API.
GOOGLE_MAPS_SERVER_API_KEY=
MAPS_REQUEST_TIMEOUT_SECONDS=10

# Bounded local agent runtime
AGENT_TOOL_MAX_RETRIES=2
AGENT_MAX_LLM_CALLS=12
# ADK CLI/web runner limit
ADK_MAX_LLM_CALLS=12

# Optional telemetry; disabled until explicitly configured
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
