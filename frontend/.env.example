VITE_API_BASE_URL=http://localhost:8000
# Firebase web configuration is public; access is enforced with Auth and Security Rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional: use the local Firebase emulators. Never set in production.
VITE_USE_FIREBASE_EMULATORS=false
# Browser key: restrict to your website origins and Maps JavaScript API.
VITE_GOOGLE_MAPS_API_KEY=
# Optional Cloud Console map ID for cloud styling.
VITE_GOOGLE_MAPS_MAP_ID=
# Initial viewport only; these values do not create a depot or vehicle.
VITE_MAP_CENTER_LAT=20.5937
VITE_MAP_CENTER_LNG=78.9629
