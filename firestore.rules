rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function canManage(organizationId) {
      return signedIn()
        && exists(/databases/$(database)/documents/organizations/$(organizationId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/organizations/$(organizationId)/members/$(request.auth.uid)).data.role in ['owner', 'dispatcher'];
    }

    // Membership and workspace indexes are maintained by authorized server code.
    match /users/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list, write: if false;
    }

    match /organizations/{organizationId} {
      allow get: if canManage(organizationId);
      allow list, write: if false;

      match /members/{userId} {
        allow get: if signedIn() && request.auth.uid == userId;
        allow list, write: if false;
      }

      match /deliveries/{deliveryId} {
        allow read: if canManage(organizationId);
        allow write: if false;
      }

      match /vehicles/{vehicleId} {
        allow read: if canManage(organizationId);
        allow write: if false;
      }
    }

    // Direct client writes cannot bypass the API's validation/version checks.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
